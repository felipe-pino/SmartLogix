# --- BASE DE DATOS ---
# Estas variables las usará el contenedor de Postgres para crearse
# y los microservicios para conectarse.
DB_USERNAME=postgres
DB_PASSWORD=123456

# --- SEGURIDAD ---
# Esta clave DEBE ser la misma para todos.
# Es la que firma los tokens en Auth-Service y los valida en Gateway/Inventory/etc.
JWT_SECRET=SmartLogixSuperSecretKeyForJWT2024PlatformMicroservicesArchitecture!!

# --- INFRAESTRUCTURA ---
# URL de Eureka (útil si corres algo fuera de Docker)
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://discovery-service:8761/eureka/